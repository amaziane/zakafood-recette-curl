# ---- Site ----
BASE_URL=https://zakafood.com

# ---- Adresse qui reçoit les e-mails de test ----
# Avec EMAIL_PLUS=1, chaque run utilise une adresse unique : prenom+zk<run>@domaine (Gmail, Outlook, Fastmail... gèrent le "+").
TEST_EMAIL=
EMAIL_PLUS=1

# ---- Compte admin WordPress ----
WP_ADMIN_USER=
# Mot de passe d'application (Utilisateurs > Profil > Mots de passe d'application) : sert à l'API REST (vérifs, journal des mails, nettoyage).
WP_APP_PASSWORD=
# Mot de passe normal : sert UNIQUEMENT à la validation du compte via l'écran « Clients Zaka Food » (admin-ajax).
# Laisse vide pour basculer sur une validation par API (l'e-mail d'approbation B2BKing ne sera alors pas testé).
WP_ADMIN_PASSWORD=

# ---- Données du client de test ----
TEST_PASSWORD=ZkTest-2026!Recette
TEST_COMPANY=ZK TEST SRL (recette auto)
TEST_VAT=BE0000000097
TEST_PHONE=+32470000000
TEST_ACTIVITY=restaurant
TEST_ADDRESS=Rue du Test 1
TEST_POSTCODE=7700
TEST_CITY=Mouscron
TEST_COUNTRY=BE

# ---- Commande ----
# ID produit à commander (vide = premier produit en stock trouvé via l'API Store)
PRODUCT_ID=

# Délai max d'attente d'un e-mail dans le journal SureMails (secondes)
MAIL_WAIT=90
